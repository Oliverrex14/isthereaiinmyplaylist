# ========================================================================
# IsThereAIInMyPlaylist — Environment Variables Configuration
# ========================================================================
# For local development: copy this file to .env
# For production (Vercel): add these in Project Settings -> Environment Variables

# 1. Cryptographic Session Secret
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_random_64_character_session_secret_key_here

# 2. Spotify OAuth 2.0 Credentials (Optional - enables "Sign in with Spotify")
# Create an app at: https://developer.spotify.com/dashboard
# Redirect URI to configure in Spotify Dashboard:
#   Local: http://localhost:3000/api/auth/callback?provider=spotify
#   Production: https://your-domain.vercel.app/api/auth/callback?provider=spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 3. Google OAuth 2.0 Credentials (Optional - enables "Sign in with Google")
# Create an OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI in Google Console:
#   Local: http://localhost:3000/api/auth/callback?provider=google
#   Production: https://your-domain.vercel.app/api/auth/callback?provider=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
